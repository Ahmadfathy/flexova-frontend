    { "id": "au_002", "user_id": "usr_mgr_nasr", "action": "sales.discount.override", "sensitive": true, "when": "2026-06-12T14:20:00", "branch_id": "br_nasr", "target": "NS-INV-1041", "summary_ar": "تجاوز خصم بصلاحية" },
    { "id": "au_003", "user_id": "usr_owner", "action": "crm.credit.override", "sensitive": true, "when": "2026-06-13T11:00:00", "branch_id": "br_main", "target": "cu_overdue", "summary_ar": "تجاوز حد ائتمان بقالة الحاج كمال" },
    { "id": "au_004", "user_id": "usr_owner", "action": "admin.user.manage", "sensitive": true, "when": "2026-05-01T10:05:00", "branch_id": null, "target": "usr_old", "summary_ar": "إيقاف مستخدم محمود السيد" },
