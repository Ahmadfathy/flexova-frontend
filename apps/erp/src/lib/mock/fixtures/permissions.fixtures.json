    { "id": "usr_cashier_nasr", "name_ar": "فاطمة محمود", "login": "01000000005", "roles": ["role_cashier"], "scope": { "branches": ["br_nasr"], "row_rule": "own" }, "status": "active", "twofa": false, "last_login": "2026-06-13T21:02:00" },
    { "id": "usr_rep", "name_ar": "كريم سمير", "login": "01000000003", "roles": ["role_sales_rep"], "scope": { "branches": ["br_nasr"], "row_rule": "own" }, "status": "active", "twofa": false, "last_login": "2026-06-12T18:00:00" },
    { "id": "usr_old", "name_ar": "محمود السيد", "login": "01099990000", "roles": ["role_stock_keeper"], "scope": { "branches": ["br_main"], "row_rule": "branch" }, "status": "suspended", "twofa": false, "last_login": "2026-05-01T10:00:00" }
  ],

  "sessions": [
    { "id": "ses_001", "user_id": "usr_owner", "device": "Chrome · Windows", "ip": "156.x.x.x", "started": "2026-06-14T07:50:00", "current": true },
    { "id": "ses_002", "user_id": "usr_cashier_nasr", "device": "Flexova POS · Android", "ip": "branch-lan", "started": "2026-06-13T09:00:00", "current": false }
  ],

  "security_policy": {
    "password": { "min_length": 8, "require_number": true, "require_symbol": false },
    "twofa": { "available": true, "enforced": false },
    "session_timeout_minutes": 120,
    "trusted_devices": true
  },

  "audit_log": [
