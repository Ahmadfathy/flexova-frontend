{
  "_meta": {
    "module": "admin",
    "version": "1.0",
    "depends_on": "consolidates permission keys from FE_01..07",
    "notes": "Default-deny. Two scope dimensions: branch + row(all/branch/own). Sensitive ⚠ actions write immutable audit. Last-admin lock. Suspend not delete. Multi-tenant isolated."
  },

  "branches": [
    { "id": "br_main", "name_ar": "الفرع الرئيسي", "name_en": "Main Branch", "code": "BR-01" },
    { "id": "br_nasr", "name_ar": "فرع مدينة نصر", "name_en": "Nasr City Branch", "code": "BR-02" }
  ],

  "permission_catalog": {
    "inventory": ["inventory.view","item.manage","stock.adjust!","transfer","count","valuation.view"],
    "sales": ["sales.view","invoice.create","invoice.submit","invoice.cancel!","return!","quote","discount.override!","eta.send","eta.resend","eta.settings!"],
    "purchasing": ["purchasing.view","po.create","invoice.create","invoice.approve","receipt.create","return!","supplier.manage","payment.create","inbound.respond!"],
    "finance": ["finance.view_simple","view_accounting","expense.create","receipt.create","payment.create","transfer","treasury.manage","journal.manual!","coa.manage!","reconcile","period.close!","period.reopen!!","reports.view"],
    "crm": ["crm.customer.view","create","edit","merge!","credit.set","credit.override!","followup.manage","loyalty.manage","communicate","import","export"],
    "hr": ["hr.employee.view","manage","attendance.manage","advance.request","advance.approve!","commission.manage","payroll.run","payroll.approve!","statutory.config!!","payslip.view","export"],
    "reports": ["reports.view","view_financial!","view_all_branches","build","save","schedule","export","dashboard.customize","eta.view"],
    "admin": ["admin.user.manage!","role.manage!","security.config!!","audit.view","branch.manage"],
    "healthcare": ["healthcare.today.view","healthcare.patients.view","healthcare.patients.view_all","healthcare.clinical.view!","healthcare.clinical.edit!","healthcare.lab.manage!","healthcare.insurance.manage","healthcare.catalog.manage"],
    "ecommerce": ["ecommerce.products.manage","ecommerce.orders.view","ecommerce.orders.manage","ecommerce.orders.refund!","ecommerce.affiliates.manage","ecommerce.affiliates.payout!","ecommerce.settings.manage","ecommerce.catalog.configure!"]
  },

  "role_templates": [
    { "id": "role_owner", "name_ar": "المالك", "name_en": "Owner", "template": true, "user_count": 1,
      "permissions": "*", "exclude": ["healthcare.clinical.view!"], "scope": { "branches": "all", "row_rule": "all" },
      "_note": "Healthcare §11/§12 SoD carve-out on the wildcard: owner is governance + aggregate reports, no individual clinical PHI by default — every other module's '*' access is untouched" },
    { "id": "role_branch_mgr", "name_ar": "مدير فرع", "name_en": "Branch Manager", "template": true, "user_count": 1,
      "permissions": ["sales.*","inventory.*","purchasing.view","crm.*","reports.view","reports.eta.view"], "exclude": ["admin.*","period.reopen!!"], "scope": { "branches": ["assigned"], "row_rule": "branch" } },
    { "id": "role_cashier", "name_ar": "كاشير", "name_en": "Cashier", "template": true, "user_count": 1,
      "permissions": ["sales.view","invoice.create","invoice.submit","eta.send","finance.receipt.create","reports.view"], "scope": { "branches": ["assigned"], "row_rule": "own" } },
    { "id": "role_accountant", "name_ar": "محاسب", "name_en": "Accountant", "template": true, "user_count": 1,
      "permissions": ["finance.*","reports.view_financial!","reports.view","purchasing.view","sales.view","healthcare.patients.view","healthcare.insurance.manage"], "exclude": ["*.delete","period.reopen!!","healthcare.clinical.view!"], "scope": { "branches": "all", "row_rule": "all" } },
    { "id": "role_stock_keeper", "name_ar": "أمين مخزن", "name_en": "Stock Keeper", "template": true, "user_count": 0,
      "permissions": ["inventory.view","item.manage","count","transfer","stock.adjust!"], "scope": { "branches": ["assigned"], "row_rule": "branch" } },
    { "id": "role_sales_rep", "name_ar": "مندوب مبيعات", "name_en": "Sales Rep", "template": true, "user_count": 1,
      "permissions": ["sales.view","invoice.create","crm.customer.view","crm.create","crm.communicate","finance.receipt.create"], "scope": { "branches": ["assigned"], "row_rule": "own" } },
    { "id": "role_hc_reception", "name_ar": "استقبال (رعاية صحية)", "name_en": "Reception (Healthcare)", "template": true, "user_count": 0,
      "permissions": ["healthcare.today.view","healthcare.patients.view","finance.receipt.create","reports.view"], "exclude": ["healthcare.clinical.view!","healthcare.clinical.edit!","healthcare.insurance.manage"], "scope": { "branches": ["assigned"], "row_rule": "branch" },
      "_note": "§12 matrix: Today Board + contact/financial status only; diagnosis/prescription/results never visible" },
    { "id": "role_hc_provider", "name_ar": "طبيب / مقدّم خدمة", "name_en": "Doctor / Provider", "template": true, "user_count": 0,
      "permissions": ["healthcare.today.view","healthcare.patients.view","healthcare.clinical.view!","healthcare.clinical.edit!"], "exclude": ["healthcare.patients.view_all","healthcare.insurance.manage","healthcare.catalog.manage"], "scope": { "branches": ["assigned"], "row_rule": "own" },
      "_note": "§12 matrix: own patients/appointments by default (row_rule:own, no view_all); full clinical read/write; no insurance/catalog admin" },
    { "id": "role_ec_manager", "name_ar": "مدير المتجر الإلكتروني", "name_en": "E-commerce Manager", "template": true, "user_count": 0,
      "permissions": ["ecommerce.products.manage","ecommerce.orders.view","ecommerce.orders.manage","ecommerce.affiliates.manage","ecommerce.settings.manage"], "exclude": ["ecommerce.catalog.configure!","ecommerce.affiliates.payout!"], "scope": { "branches": "all", "row_rule": "all" },
      "_note": "FE_21 §10 'refund/payout are governance-sensitive' — day-to-day store management (publish, fulfill, affiliates, settings) without refund or payout authority; ecommerce.orders.refund! and ecommerce.affiliates.payout! are deliberately omitted, granted only via Owner or an explicit additional role. §3.7's catalog_mode switch is the same kind of decision (picks how the whole catalog populates, not a single record) so ecommerce.catalog.configure! is excluded here too — a manager can run bulk-import/mirror-hide day to day (those are ecommerce.products.manage) but can't change the mode itself. ecommerce.affiliates.manage still covers add/edit, links, and viewing balances — approving/disbursing a payout now requires the separate ecommerce.affiliates.payout! key, which this role does not hold." }
  ],

  "users": [
    { "id": "usr_owner", "name_ar": "أحمد حسن", "login": "01000000001", "roles": ["role_owner"], "scope": { "branches": "all", "row_rule": "all" }, "status": "active", "twofa": true, "last_login": "2026-06-14T07:50:00", "is_last_admin": true },
