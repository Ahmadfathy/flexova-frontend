  ],

  "blocked_examples": [
    { "user_id": "usr_cashier_nasr", "attempted": "finance.period.close", "result": "blocked", "message_ar": "تحتاج صلاحية إقفال الفترة — راجع الأدمن", "message_en": "You need the period-close permission — ask your admin" }
  ],

  "last_admin_lock": { "user_id": "usr_owner", "rule": "cannot_disable_or_demote", "reason_ar": "آخر مدير للنظام" },

  "mock_states": ["loading", "empty", "error", "no_results", "offline"]
}
